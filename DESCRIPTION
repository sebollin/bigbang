Package: bigbang
Type: Package
Title: Build 'Tidyverse'-Style Meta-Packages from Local Package Files
Version: 0.1.0.9000
Authors@R: c(
    person(given = "Sebastian",
           family = "Lucas",
           role = c("aut", "cre"),
           email = "sebalucas@gmail.com"),
    person(given = "Richard",
           family = "Detomasi",
           role = "ctb",
